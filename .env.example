SIVAY_DATABASE_URL=sqlite:///./sivay.db
# Docker Compose requires a strong generated password (see scripts/init_deploy_env.py).
# POSTGRES_PASSWORD=...
# SIVAY_API_KEY=... (minimum 32 characters; required for a deployed backend)
SIVAY_RULES_PATH=rules
SIVAY_GAEZ_ROOT=data/gaez
# SIVAY_GAEZ_MANIFEST=data/gaez/manifest.json
SIVAY_REGIONS_PATH=data/regions.geojson
# SIVAY_PRICES_PATH=data/prices.csv
# SIVAY_EXCHANGE_RATES_PATH=data/exchange_rates.csv
# SIVAY_SATELLITE_PATH=data/satellite.json
# SIVAY_WEATHER_PATH=data/weather.json
SIVAY_DEMO=false
SIVAY_RANKING_PROFILE=personalized
SIVAY_PERSONALIZATION_POLICY_PATH=rules/personalization.json
SIVAY_AUTOMATIC_SOURCES_ENABLED=true
SIVAY_AUTOMATIC_WEATHER_TTL_SECONDS=3600
SIVAY_AUTOMATIC_INDICES_TTL_SECONDS=21600
# SIVAY_CORS_ORIGINS='["http://localhost:3000"]'
SIVAY_WEATHER_ENABLED=false
